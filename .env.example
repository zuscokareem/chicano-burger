# Copy to .env.local for local development. Set the real values in Vercel → Project → Settings → Environment Variables.
# Without STRIPE_SECRET_KEY the site runs in demo mode (bookings are confirmed with no payment).

# Stripe (use sk_test_… for testing, sk_live_… for real money)
STRIPE_SECRET_KEY=
# From Stripe → Developers → Webhooks, endpoint https://<domain>/api/stripe/webhook,
# events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_WEBHOOK_SECRET=

# Reservation storage: Upstash Redis (Vercel Marketplace sets these automatically)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Staff dashboard at /staff. Required once a live Stripe key is set.
STAFF_PASSWORD=

# Vercel sends this to the nightly no-show job. Any long random string.
CRON_SECRET=
# Set to "false" to turn off the automatic nightly no-show sweep (staff can still mark no-shows by hand).
AUTO_NO_SHOW=
